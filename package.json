{
  "name": "listpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Applies a plan.json to Google Maps saved lists via Playwright over CDP, then verifies with a hard reload.",
  "scripts": {
    "chrome": "bash scripts/launch-chrome.sh",
    "apply": "tsx src/run.ts",
    "dry": "tsx src/run.ts --dry-run",
    "probe": "tsx src/probe.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright-core": "^1.55.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
