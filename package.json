{
  "name": "maps-lists",
  "version": "0.3.23",
  "private": true,
  "license": "MIT",
  "author": "Ilia Litvinenko",
  "type": "module",
  "description": "Builds Google Maps saved lists from research or a .md file: Playwright over CDP, then verifies with a hard reload. Also a Claude Code plugin.",
  "scripts": {
    "chrome": "bash scripts/launch-chrome.sh",
    "apply": "tsx src/run.ts",
    "dry": "tsx src/run.ts --dry-run",
    "probe": "tsx src/probe.ts",
    "resolve": "tsx src/resolve.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "test:hooks": "bash scripts/test-hooks.sh",
    "start": "bash start.sh",
    "review": "tsx src/review.ts",
    "clean": "tsx src/clean.ts",
    "reddit": "tsx src/reddit.ts",
    "check-plan": "tsx src/plan.ts --check"
  },
  "dependencies": {
    "playwright-core": "^1.55.0",
    "tsx": "^4.19.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
